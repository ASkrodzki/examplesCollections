$ErrorActionPreference = 'Stop'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$version = '152.0.7977.7500'
$url = "https://artifactory.mbank.pl/artifactory/nuget-external-cache/Selenium.WebDriver.ChromeDriver.$version.nupkg"
$driverPath = Join-Path $env:WORKSPACE 'out\chromedriver.exe'
$tempDir = Join-Path $env:TEMP ("driver-" + [guid]::NewGuid())

if (!(Test-Path -LiteralPath $driverPath -PathType Leaf)) {
    throw "Nie znaleziono drivera do podmiany: $driverPath"
}

New-Item -ItemType Directory -Path $tempDir | Out-Null

try {
    # Paczka NuGet jest archiwum ZIP.
    $zip = Join-Path $tempDir 'package.zip'
    Invoke-WebRequest -Uri $url -OutFile $zip -UseBasicParsing
    Expand-Archive -LiteralPath $zip -DestinationPath $tempDir

    $newDriver = Join-Path $tempDir 'driver\win32\chromedriver.exe'
    if (!(Test-Path -LiteralPath $newDriver -PathType Leaf)) {
        throw 'W paczce brakuje driver\win32\chromedriver.exe'
    }

    $result = & $newDriver --version
    if ($LASTEXITCODE -ne 0 -or
        $result -notmatch '^ChromeDriver 152\.0\.7977\.75(?:\s|$)') {
        throw "Nieoczekiwana wersja drivera: $result"
    }

    $backup = "$driverPath.bak-$(Get-Date -Format yyyyMMddHHmmss)"
    Copy-Item -LiteralPath $driverPath -Destination $backup
    Copy-Item -LiteralPath $newDriver -Destination $driverPath -Force

    Write-Host "Zainstalowano: $result"
    Write-Host "Plik: $driverPath"
    Write-Host "Kopia: $backup"
}
finally {
    Remove-Item -LiteralPath $tempDir -Recurse -Force
}

